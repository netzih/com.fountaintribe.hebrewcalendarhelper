<?xml version="1.0"?>
<extension key="com.fountaintribe.hebrewcalendarhelper" type="module">
  <file>hebrewcalendarhelper</file>
  <name>Hebrew Calendar Helper</name>
  <description>Hebrew calendar tools for CiviCRM: Hebrew dates of birth and death, yahrzeits and bar/bat mitzvah dates, a Yahrzeits search, and mail tokens for yahrzeits, today's Hebrew date and this week's Shabbat and Yom Tov times.</description>
  <license>AGPL-3.0</license>
  <maintainer>
    <author>Sarah Gladstone</author>
    <email>info@fountaintribe.com</email>
  </maintainer>
  <urls>
    <url desc="Main Extension Page">https://civicrm.org/extensions/hebrew-calendar</url>
    <url desc="Documentation">https://lab.civicrm.org/Chabadrichmond/hebrewcalendarhelper/-/blob/master/README.md</url>
    <url desc="Support">https://lab.civicrm.org/Chabadrichmond/hebrewcalendarhelper/-/issues</url>
    <url desc="Licensing">http://www.gnu.org/licenses/agpl-3.0.html</url>
  </urls>
  <releaseDate>2026-10-10</releaseDate>
  <version>4.1.0-beta1</version>
  <develStage>beta</develStage>
  <compatibility>
    <ver>5.78</ver>
  </compatibility>
  <comments/>
  <civix>
    <namespace>CRM/Hebrewcalendarhelper</namespace>
    <format>24.09.1</format>
  </civix>
  <mixins>
    <mixin>menu-xml@1.0.0</mixin>
    <mixin>mgd-php@1.0.0</mixin>
    <mixin>smarty-v2@1.0.3</mixin>
    <mixin>entity-types-php@2.0.0</mixin>
    <mixin>setting-php@1.0.0</mixin>
    <mixin>setting-admin@1.1.1</mixin>
  </mixins>
  <classloader>
    <psr0 prefix="CRM_" path="."/>
    <psr4 prefix="Civi\" path="Civi"/>
  </classloader>
  <upgrader>CiviMix\Schema\Hebrewcalendarhelper\AutomaticUpgrader</upgrader>
</extension>
